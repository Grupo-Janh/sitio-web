---
const { titulo, texto } = Astro.props;
---
<article>
  <h3>{titulo}</h3>
  <p>{texto}</p>
</article>

<style>
  article {
    border: 1px solid var(--color-borde);
    border-radius: var(--radio);
    padding: var(--espacio-m);
  }
  h3 {
    color: var(--color-primario);
    margin-top: 0;
  }
  p {
    color: var(--color-texto-suave);
    margin-bottom: 0;
  }
</style>