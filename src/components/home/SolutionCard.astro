---
/**
 * SOLUTION CARD — HOME JANH
 *
 * RESPONSABILIDAD:
 * Representar una solución tecnológica dentro de la
 * sección principal de Soluciones de la Home.
 *
 * PROPS:
 * number      → número visual de la solución.
 * title       → nombre de la solución.
 * description → descripción resumida.
 * href        → página de detalle.
 *
 * CONSUMIDO POR:
 * - Solutions.astro
 *
 * NO DEBE CONTENER:
 * - Datos propios de las soluciones.
 * - Posicionamiento general de la sección.
 * - Lógica de carrusel.
 * - Animaciones GSAP globales.
 *
 * FUTURO:
 * - Imagen específica por solución.
 * - Iconografía definitiva.
 * - Hover visual avanzado.
 */

const {
  number,
  title,
  description,
  href = "/soluciones",
} = Astro.props;
---

<article
  class="
    group
    relative
    flex
    min-h-\260px\
    h-full
    flex-col
    justify-between
    overflow-hidden
    rounded-3xl
    border border-janh-tinta/10
    bg-white
    p-6
    transition
    duration-300
    hover:-translate-y-1
    hover:shadow-xl
  "
>

  <!-- Cabecera visual -->
  <div class="flex items-center justify-between">

    <span
      class="
        text-xs
        font-medium
        tracking-[0.18em]
        text-janh-lila
      "
    >
      {number}
    </span>

  </div>


  <!-- Contenido principal -->
  <div class="mt-14">

    <h3
      class="
        text-2xl
        font-semibold
        tracking-tight
        text-janh-tinta
      "
    >
      {title}
    </h3>

    <p
      class="
        mt-3
        text-sm
        leading-6
        text-janh-tinta/60
      "
    >
      {description}
    </p>

    <a
      href={href}
      class="
        mt-6
        inline-flex
        items-center
        gap-2
        text-sm
        font-medium
        text-janh-violeta
        transition
        group-hover:text-janh-magenta
      "
    >
      Conocer solución
      <span aria-hidden="true">→</span>
    </a>

  </div>

</article>