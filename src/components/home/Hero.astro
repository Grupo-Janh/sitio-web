---
/**
 * HERO — HOME JANH
 *
 * RESPONSABILIDAD:
 * Primera sección visual de la página principal.
 * Debe comunicar rápidamente la propuesta de valor de JANH.
 *
 * CONTIENE:
 * - Eyebrow de soluciones.
 * - Título principal H1.
 * - Descripción.
 * - CTAs principales.
 * - Beneficios.
 * - Visual principal.
 *
 * DEPENDE DE:
 * - Container.astro
 * - Button.astro
 * - HeroBenefit.astro
 * - Astro Image
 * - assets/hero/hero.png
 *
 * NO DEBE CONTENER:
 * - Navbar.
 * - Footer.
 * - Servicios completos.
 * - Lógica de formularios.
 *
 * ANIMACIONES:
 * Todavía ninguna.
 * Posteriormente GSAP controlará únicamente la entrada
 * y movimientos decorativos del Hero.
 */

import { Image } from "astro:assets";

import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import HeroBenefit from "./HeroBenefit.astro";
import heroImage from "../../assets/hero/hero.png";

const benefits = [
  {
    title: "Confianza",
    description: "Operación segura y continua.",
    icon: "◇",
  },
  {
    title: "Escalabilidad",
    description: "Infraestructura lista para crecer contigo.",
    icon: "▥",
  },
  {
    title: "Acompañamiento",
    description: "Soporte experto en cada etapa.",
    icon: "○",
  },
];
---

<section class="pt-8 pb-16 lg:pt-12 lg:pb-24">
  <Container>
    <div class="grid gap-8 lg:grid-cols-2 lg:gap-10">
      <!-- =========================================
           COLUMNA IZQUIERDA
           Contenido principal del Hero
      ========================================== -->

      <div class="rounded-3xl bg-white p-8 sm:p-10 lg:p-12">
        <p
          class="text-xs font-medium tracking-[0.15em] text-janh-lila uppercase"
        >
          Infraestructura · Videovigilancia · Redes · Ciberseguridad · Cloud
        </p>

        <h1
          class="mt-7 text-4xl font-bold leading-[1.05] tracking-tight text-janh-tinta sm:text-5xl lg:text-6xl"
        >
          Tecnología que impulsa tu operación.
        </h1>

        <!-- Decorador -->
        <div
          class="mt-6 h-1 w-16 rounded-full gradiente-janh"
          aria-hidden="true"
        >
        </div>

        <p class="mt-8 max-w-xl text-base leading-7 text-janh-tinta/70">
          Diseñamos, implementamos y operamos soluciones tecnológicas que
          fortalecen tu empresa y la preparan para el futuro.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="/contacto"> Agendar reunión → </Button>

          <Button href="/soluciones" variant="secondary">
            Explorar soluciones →
          </Button>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {
            benefits.map((benefit) => (
              <HeroBenefit
                title={benefit.title}
                description={benefit.description}
                icon={benefit.icon}
              />
            ))
          }
        </div>
      </div>

      <!-- =========================================
           COLUMNA DERECHA
           Placeholder temporal del Hero visual
      ========================================== -->

      <div
        class="relative min-h-[420px] overflow-hidden rounded-3xl bg-janh-tinta/5 sm:min-h-[520px] lg:min-h-full"
      >
        <Image
          src={heroImage}
          alt="Soluciones tecnológicas integrales de Grupo JANH"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
    </div>
  </Container>
</section>
