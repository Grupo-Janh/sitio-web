---
/**
 * Botón reutilizable de JANH.
 *
 * RESPONSABILIDAD:
 * - Mantener botones visualmente consistentes.
 *
 * PROPS:
 * href    → destino del botón.
 * variant → estilo visual ("primary" | "secondary").
 *
 * EJEMPLO:
 *
 * <Button href="/agendar">
 *   Agendar reunión
 * </Button>
 */

const {
  href = "/",
  variant = "primary"
} = Astro.props;

const variants = {
  primary:
    "gradiente-janh text-white hover:opacity-90",
  secondary:
    "border border-janh-violeta bg-white text-janh-violeta hover:bg-janh-hueso"
};

const classes =
  variants[variant as keyof typeof variants] ??
  variants.primary;
---
<a
  href={href}
  class:list={[
    "inline-flex items-center justify-center rounded-xl px-5 py-3 text-sm font-medium transition duration-200",
    classes
  ]}
>
  <slot />
</a>