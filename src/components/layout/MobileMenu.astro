---
/**
 * Menú móvil principal de JANH.
 *
 * RESPONSABILIDAD:
 * - Navegación para pantallas pequeñas.
 *
 * POR AHORA:
 * - Utiliza <details> nativo.
 * - No requiere JavaScript.
 *
 * DESPUÉS:
 * - Podremos sustituir/animar el comportamiento
 *   con JavaScript o GSAP.
 */

import { navigation } from '../../data/site';

---

<div class="relative lg:hidden">

  <details class="group">

    <summary
      class="flex size-11 cursor-pointer list-none items-center justify-center rounded-xl border border-janh-tinta/10 bg-white text-janh-tinta"
      aria-label="Abrir menú de navegación"
    >
      <span class="text-xl">
        ☰
      </span>
    </summary>

    <div
      class="absolute right-0 top-14 w-72 rounded-2xl border border-janh-tinta/10 bg-white p-4 shadow-xl"
    >

      <nav aria-label="Navegación móvil">

        <ul class="flex flex-col">

          {
            navigation.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="block rounded-xl px-4 py-3 text-sm font-medium text-janh-tinta transition hover:bg-janh-hueso hover:text-janh-magenta"
                >
                  {link.label}
                </a>
              </li>
            ))
          }

        </ul>

        <a
          href="/contacto"
          class="gradiente-janh mt-4 flex items-center justify-center rounded-xl px-5 py-3 text-sm font-medium text-white"
        >
          Agendar reunión →
        </a>

      </nav>

    </div>

  </details>

</div>