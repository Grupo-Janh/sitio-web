---
/**
 * Layout base de JANH.
 *
 * RESPONSABILIDAD:
 * Ser la estructura HTML principal de todas las páginas.
 *
 * CONTIENE:
 * - Metadata
 * - Header
 * - Contenido de página mediante <slot />
 * - Footer
 *
 * NO CONTIENE:
 * - Contenido específico del Home
 * - Servicios
 * - Hero
 */

import '../styles/global.css';

import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const { titulo, descripcion } = Astro.props;
---

<!doctype html>

<html lang="es">

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <link
      href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&display=swap"
      rel="stylesheet"
    />

    <title>{titulo}</title>

    <meta
      name="description"
      content={descripcion}
    />

  </head>

  <body class="font-sans antialiased">

    <Header />

    <main>
      <slot />
    </main>

    <Footer />

  </body>

</html>